{
  "name": "portfoliable-repo",
  "version": "0.4.15",
  "description": "Repository root for create-portfoliable maintainer workflows.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/portfoliablejs/portfoliable",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portfoliablejs/portfoliable.git"
  },
  "bugs": {
    "url": "https://github.com/portfoliablejs/portfoliable/issues"
  },
  "files": [
    "cli",
    "create-portfoliable",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "portfoliable": "cli/portfoliable.mjs"
  },
  "scripts": {
    "postinstall": "npm --prefix ./create-portfoliable ci",
    "ensure:valence": "npm --prefix ./create-portfoliable run ensure:valence",
    "sync:templates": "echo 'sync:templates is retired; create-portfoliable is now canonical.'",
    "check:templates": "echo 'check:templates is retired; create-portfoliable is now canonical.'",
    "validate:content": "npm --prefix ./create-portfoliable run validate:content",
    "portfoliable": "npm --prefix ./create-portfoliable run portfoliable --",
    "dev": "npm --prefix ./create-portfoliable run dev --",
    "build": "npm --prefix ./create-portfoliable run build",
    "preview": "npm --prefix ./create-portfoliable run preview --",
    "thumbnail:options": "npm --prefix ./create-portfoliable run thumbnail:options --",
    "create:case": "npm --prefix ./create-portfoliable run create:case --",
    "scaffold:case": "npm --prefix ./create-portfoliable run scaffold:case --",
    "verify:integration": "npm --prefix ./create-portfoliable run verify:integration --",
    "smoke:homeview": "npm --prefix ./create-portfoliable run smoke:homeview",
    "smoke:initializer": "npm --prefix ./create-portfoliable run smoke:initializer",
    "smoke:packed": "npm --prefix ./create-portfoliable run smoke:packed"
  },
  "dependencies": {},
  "devDependencies": {},
  "funding": "https://github.com/sponsors/schimanko"
}
