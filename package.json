{
  "name": "@portfoliablejs/portfoliable",
  "version": "2.4.10",
  "description": "Template-first portfolio engine powered by valence web components",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/portfoliablejs/portfoliable",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portfoliablejs/portfoliable.git"
  },
  "bugs": {
    "url": "https://github.com/portfoliablejs/portfoliable/issues"
  },
  "files": [
    "cli",
    "scripts",
    "src",
    "css",
    "public",
    "index.html",
    "portfoliable.config.js",
    "vite.config.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "src/App.js",
  "bin": {
    "portfoliable": "cli/portfoliable.mjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/ensure-valence-index-css.mjs",
    "ensure:valence": "node ./scripts/ensure-valence-index-css.mjs",
    "validate:content": "node ./cli/portfoliable.mjs validate",
    "preportfoliable": "node ./scripts/check-updates.mjs",
    "predev": "npm run ensure:valence && npm run validate:content",
    "prebuild": "npm run ensure:valence && npm run validate:content",
    "prepreview": "npm run ensure:valence && npm run validate:content",
    "portfoliable": "node ./cli/portfoliable.mjs dev",
    "dev": "npm run portfoliable --",
    "build": "node ./cli/portfoliable.mjs build",
    "preview": "node ./cli/portfoliable.mjs preview",
    "scaffold:consumer": "node ./cli/portfoliable.mjs scaffold",
    "scaffold:case": "node ./cli/portfoliable.mjs scaffold-case",
    "verify:integration": "node ./scripts/verify-integration.mjs",
    "smoke:homeview": "node ./scripts/smoke-homeview.mjs",
    "smoke:initializer": "node ./scripts/smoke-initializer.mjs"
  },
  "dependencies": {
    "@portfoliablejs/valence": "^0.1.0",
    "vite": "^8.1.1"
  },
  "devDependencies": {},
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
