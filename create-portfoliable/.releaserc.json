{
  "tagFormat": "create-portfoliable-v${version}",
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "create-portfoliable/CHANGELOG.md"
    }],
    ["@semantic-release/npm", {
      "pkgRoot": "create-portfoliable"
    }],
    ["@semantic-release/github", {
      "successComment": false,
      "failComment": false
    }],
    ["@semantic-release/git", {
      "assets": ["create-portfoliable/CHANGELOG.md", "create-portfoliable/package.json"],
      "message": "chore(release): create-portfoliable@${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }]
  ]
}
